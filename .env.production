# Production build env (vite build loads this before .env).
# IMPORTANT: real environment variables (e.g. Vercel dashboard vars) OVERRIDE
# this file - delete any VITE_API_BASE_URL / VITE_BACKEND_URL set in
# Vercel -> Settings -> Environment Variables, or this file is ignored.
#
# `vite build` refuses to run in production mode while either value still
# contains YOUR_BACKEND_HOST or points at localhost/127.0.0.1: a bundle built
# that way calls the developer's own machine, so the deployed dashboard can
# never reach the API (image uploads included).

# Laravel production API origin (the /api prefix is included).
VITE_API_BASE_URL=https://YOUR_BACKEND_HOST/api

# Laravel production origin without /api. Used for /storage/... image URLs.
VITE_BACKEND_URL=https://YOUR_BACKEND_HOST

# VITE_* values are inlined into the public JS bundle, so the key is not
# secret here; lock it down with HTTP-referrer restrictions in Google Cloud
# Console (Maps JavaScript API, Places API, Geocoding API).
VITE_GOOGLE_MAPS_API_KEY=AIzaSyCj1_lipaewZfFe-VnyJ-jKWHetRkL-4Jo
