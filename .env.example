# Laravel REST API base URL (the /api prefix is included).
VITE_API_BASE_URL=http://127.0.0.1:8000/api

# Laravel origin without the /api suffix. Used to build /storage/... image URLs.
# Must match one of the origins listed in FRONTEND_URL in the Laravel .env.
VITE_BACKEND_URL=http://127.0.0.1:8000

# Google Maps JavaScript API key for the checkout delivery-location map.
# Needs "Maps JavaScript API", "Places API" and "Geocoding API" enabled.
# Left blank on purpose: the key is personal and must not be committed.
VITE_GOOGLE_MAPS_API_KEY=
