{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "compilerOptions": {
    /* The inherited @vue/tsconfig sets "types": [] to keep Node globals out of
       the DOM app. @types/google.maps declares the global `google.maps`
       namespace the checkout map needs, so it has to be opted into here. */
    "types": ["google.maps"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.vue"],
  "exclude": ["src/**/__tests__/**"]
}
